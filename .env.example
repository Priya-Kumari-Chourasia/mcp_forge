# Copy this file to .env and fill in your key.
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# true  = call Groq (needs GROQ_API_KEY)
# false = use the free offline stub in llm.py
USE_REAL_LLM=true

# Embeddings for the RAG index:
#   minilm = all-MiniLM-L6-v2 (default with a real LLM; downloads the model once)
#   hash   = offline bag-of-words fallback (default for the stub)
# EMBEDDINGS=minilm
