# Copy this file to .env and fill in your key.
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# true  = call Groq (needs GROQ_API_KEY)
# false = use the free offline stub in llm.py
USE_REAL_LLM=true

# Retrieval for prose docs (measured in docs/EVALUATION.md):
#   minilm = MiniLM embeddings + BM25 keywords, combined (default with a real LLM;
#            downloads the all-MiniLM-L6-v2 model once)
#   none   = BM25 keyword search only (default for the stub and the tests; no download)
# EMBEDDINGS=minilm
